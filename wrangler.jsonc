{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gs1-vbg-scan",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-30",
  // L'app (build di Vite) è servita come file statici, gratuiti e fuori dal conteggio delle richieste.
  // Il Worker entra in gioco solo per /api/*, dove aggiunge il token VbG.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Filtro anti-abuso: massimo 30 verifiche al minuto per indirizzo IP.
  "ratelimits": [
    { "name": "VBG_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }
  ],
  "observability": { "enabled": true },
  // Statistiche sulle scansioni: la chiave è il secret SUPABASE_SECRET_KEY.
  "vars": { "SUPABASE_URL": "https://bpgdftmvduzahbczxiik.supabase.co" }
}
