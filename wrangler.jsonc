{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gs1-vbg-scan",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-30",
  // Solo API: l'app è pubblicata su GitHub Pages. Le altre richieste vengono reindirizzate lì.
  // Filtro anti-abuso: massimo 30 verifiche al minuto per indirizzo IP.
  "ratelimits": [
    { "name": "VBG_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }
  ],
  "observability": { "enabled": true },
  // Statistiche sulle scansioni: la chiave è il secret SUPABASE_SECRET_KEY.
  "vars": { "SUPABASE_URL": "https://bpgdftmvduzahbczxiik.supabase.co" }
}
